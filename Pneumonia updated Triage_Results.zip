    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "assert 'results' in globals(), \"Run the simulation cell first.\"\n",
        "\n",
        "rules = ['FIFO', 'SCORE', 'SCORE+CAP', 'PERFECT']\n",
        "labels = ['FIFO', 'SCORE', 'SCORE + CAP\\n60 minutes',\n",
        "          'PERFECT\\nreference']\n",
        "\n",
        "missed_results = results[results['missed_count'] > 0]\n",
        "assert not missed_results.empty, \"No shifts contained missed cases.\"\n",
        "\n",
        "group = missed_results.groupby('rule')['missed_max_wait']\n",
        "\n",
        "means = group.mean().reindex(rules)\n",
        "low = group.quantile(0.05).reindex(rules)\n",
        "high = group.quantile(0.95).reindex(rules)\n",
        "worst = group.max().reindex(rules)\n",
        "\n",
        "n_with_missed = missed_results['run'].nunique()\n",
        "n_total = results['run'].nunique()\n",
        "x = np.arange(len(rules))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9, 6))\n",
        "\n",
        "ax.vlines(x, low, high, color='teal', linewidth=4,\n",
        "          label='5th–95th percentile of within-shift maximum waits')\n",
        "\n",
        "ax.scatter(x, means, color='black', s=65, zorder=3,\n",
        "           label='Average of within-shift maximum waits')\n",
        "\n",
        "ax.scatter(x, worst, color='darkorange', marker='D', s=65,\n",
        "           zorder=3, label='Worst missed-case wait across all runs')\n",
        "\n",
        "for position, value in zip(x, worst):\n",
        "    ax.annotate(f'{value:.1f}', (position, value),\n",
        "                xytext=(8, 6), textcoords='offset points')\n",
        "\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(labels)\n",
        "ax.set_xlim(-0.5, 3.6)\n",
        "ax.set_ylim(0, max(1, worst.max() * 1.18))\n",
        "ax.set_ylabel('Missed pneumonia waiting time (minutes)')\n",
        "ax.set_title(\n",
        "    'How long can a missed pneumonia scan wait?\\n'\n",
        "    f'{n_with_missed} of {n_total} shifts contained missed cases'\n",
        ")\n",
        "ax.grid(axis='y', alpha=0.2)\n",
        "ax.legend(loc='upper center', bbox_to_anchor=(0.5, -0.18),\n",
        "          fontsize=9)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('/content/chart2_missed_wait.png',\n",
        "            dpi=200, bbox_inches='tight')\n",
        "plt.show()\n",
        "# Repeat the experiment with three pneumonia shares.\n",
        "shares = [0.10, 0.25, 0.60]\n",
        "rules = ['FIFO', 'SCORE', 'SCORE+CAP', 'PERFECT']\n",
        "\n",
        "share_parts = []\n",
        "\n",
        "for share in shares:\n",
        "    part = run_experiment(\n",
        "        share=share,\n",
        "        cap=CAP_MIN,\n",
        "        n_runs=N_RUNS\n",
        "    )\n",
        "    part['share'] = share\n",
        "    share_parts.append(part)\n",
        "    print(f\"Finished: {share:.0%} pneumonia share\")\n",
        "\n",
        "share_results = pd.concat(share_parts, ignore_index=True)\n",
        "\n",
        "# Calculate the average results for each share and rule.\n",
        "pneumonia_wait = (\n",
        "    share_results.groupby(['share', 'rule'])['pneu_avg_wait']\n",
        "    .mean().unstack('rule').reindex(index=shares, columns=rules)\n",
        ")\n",
        "\n",
        "missed_wait = (\n",
        "    share_results.groupby(['share', 'rule'])['missed_max_wait']\n",
        "    .mean().unstack('rule').reindex(index=shares, columns=rules)\n",
        ")\n",
        "\n",
        "colors = {\n",
        "    'FIFO': 'gray',\n",
        "    'SCORE': 'tab:blue',\n",
        "    'SCORE+CAP': 'teal',\n",
        "    'PERFECT': 'tab:orange'\n",
        "}\n",
        "\n",
        "x = np.array(shares) * 100\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
        "\n",
        "for rule in rules:\n",
        "    axes[0].plot(\n",
        "        x, pneumonia_wait[rule],\n",
        "        marker='o', color=colors[rule], label=rule\n",
        "    )\n",
        "    axes[1].plot(\n",
        "        x, missed_wait[rule],\n",
        "        marker='o', color=colors[rule], label=rule\n",
        "    )\n",
        "\n",
        "axes[0].set_title('Average pneumonia waiting time')\n",
        "axes[0].set_ylabel('Average wait (minutes)')\n",
        "\n",
        "axes[1].set_title('Longest missed-case wait within a shift\\n'\n",
        "                  'Averaged over shifts with missed cases')\n",
        "axes[1].set_ylabel('Average within-shift maximum (minutes)')\n",
        "\n",
        "for ax in axes:\n",
        "    ax.set_xlabel('Assumed pneumonia share (%)')\n",
        "    ax.set_xticks(x)\n",
        "    ax.set_ylim(bottom=0)\n",
        "    ax.grid(alpha=0.2)\n",
        "    ax.legend(fontsize=8)\n",
        "\n",
        "fig.suptitle(\n",
        "    f'How do results change with pneumonia share?\\n'\n",
        "    f'{N_RUNS} runs per share · cap = {CAP_MIN} minutes'\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('/content/chart3_pneumonia_shares.png',\n",
        "            dpi=200, bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "# Count contributing shifts for the missed-case chart.\n",
        "fifo = share_results[share_results['rule'] == 'FIFO']\n",
        "counts = fifo.groupby('share')['missed_count'].apply(\n",
        "    lambda values: (values > 0).sum()\n",
        ")\n",
        "\n",
        "print(\"\\nShifts containing missed cases:\")\n",
        "for share in shares:\n",
        "    print(f\"{share:.0%} pneumonia: {counts.loc[share]} of {N_RUNS}\")"
      ],
      "metadata": {
