    {
      "cell_type": "code",
      "source": [
        "# Compare average pneumonia waits and the variation across shifts.\n",
        "rules = ['FIFO', 'SCORE', 'SCORE+CAP', 'PERFECT']\n",
        "labels = ['FIFO', 'SCORE', 'SCORE + CAP\\n60 minutes', 'PERFECT\\nreference']\n",
        "\n",
        "group = results.groupby('rule')['pneu_avg_wait']\n",
        "\n",
        "means = group.mean().reindex(rules)\n",
        "low = group.quantile(0.05).reindex(rules)\n",
        "high = group.quantile(0.95).reindex(rules)\n",
        "\n",
        "x = np.arange(len(rules))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 5))\n",
        "\n",
        "# Each vertical line shows the 5th–95th percentile across shifts.\n",
        "ax.vlines(x, low, high, color='teal', linewidth=4,\n",
        "          label='5th–95th percentile across shifts')\n",
        "\n",
        "# Each dot shows the average across shifts.\n",
        "ax.scatter(x, means, color='black', s=65, zorder=3,\n",
        "           label='Average across shifts')\n",
        "\n",
        "for position, value in zip(x, means):\n",
        "    ax.annotate(f'{value:.1f}', (position, value),\n",
        "                xytext=(10, 5), textcoords='offset points')\n",
        "\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(labels)\n",
        "ax.set_ylabel('Average pneumonia waiting time (minutes)')\n",
        "ax.set_title('Pneumonia waiting times under four reading rules\\n'\n",
        "             '500 simulated shifts · 25% pneumonia share')\n",
        "ax.set_ylim(bottom=0)\n",
