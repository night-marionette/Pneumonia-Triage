      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from google.colab import drive\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ---- All settings stay here at the top ----\n",
        "FILE_PATH = '/content/drive/MyDrive/test_scores.csv'\n",
        "ARRIVAL_MEAN_MIN = 5\n",
        "READ_MEAN_MIN = 4.5\n",
        "BACKLOG = 30\n",
        "SHIFT_MIN = 480\n",
        "CAP_MIN = 60\n",
        "N_RUNS = 500\n",
        "THRESHOLD = 0.5\n",
        "PNEUMONIA_SHARE = 0.25\n",
        "\n",
        "SHARES_TO_TEST = [0.10, 0.25, 0.60]\n",
        "CAPS_TO_TEST = [30, 60, 120]\n",
        "\n",
        "# Numbers from Night's evaluation cell. Fill them in when Night says \"final\", or leave as None.\n",
        "NIGHT_MISSED = None\n",
        "NIGHT_FALSE_ALARMS = None\n",
        "\n",
        "# ---- Connect Drive and load Night's scores ----\n",
        "drive.mount('/content/drive')\n",
        "scores = pd.read_csv(FILE_PATH)\n",
        "\n",
        "# ---- Check the file format ----\n",
        "assert {'id', 'true_label', 'score'}.issubset(scores.columns), \"Missing columns\"\n",
        "assert scores[['id', 'true_label', 'score']].notna().all().all(), \"Missing values\"\n",
        "assert scores['true_label'].isin([0, 1]).all(), \"Labels must be 0 or 1\"\n",
        "assert scores['score'].between(0, 1).all(), \"Scores must be between 0 and 1\"\n",
        "\n",
        "# ---- Count scans and mistakes ----\n",
        "normal = scores['true_label'] == 0\n",
        "pneumonia = scores['true_label'] == 1\n",
        "flagged = scores['score'] >= THRESHOLD\n",
        "\n",
        "missed_count = (pneumonia & ~flagged).sum()\n",
        "false_alarm_count = (normal & flagged).sum()\n",
        "\n",
        "print(\"Total scans:\", len(scores))\n",
        "print(\"Normal scans:\", normal.sum())\n",
        "print(\"Pneumonia scans:\", pneumonia.sum())\n",
        "print(\"Missed cases (threshold\", THRESHOLD, \"):\", missed_count)\n",
        "print(\"False alarms (threshold\", THRESHOLD, \"):\", false_alarm_count)\n",
        "\n",
        "assert len(scores) == 624, \"Expected 624 scans\"\n",
        "assert normal.sum() == 234, \"Expected 234 normal scans\"\n",
        "assert pneumonia.sum() == 390, \"Expected 390 pneumonia scans\"\n",
        "\n",
        "# ---- Compare with Night's numbers, when you have filled them in ----\n",
        "if NIGHT_MISSED is not None:\n",
        "    assert missed_count == NIGHT_MISSED, \"Missed count does not match Night's number\"\n",
        "if NIGHT_FALSE_ALARMS is not None:\n",
        "    assert false_alarm_count == NIGHT_FALSE_ALARMS, \"False alarms do not match Night's number\"\n",
        "\n",
        "print(\"\\nFile format is OK.\")\n",
        "if NIGHT_MISSED is None or NIGHT_FALSE_ALARMS is None:\n",
        "    print(\"Now compare the missed cases and false alarms above with Night's evaluation cell. They must match.\")"
      ],
      "metadata": {
        "colab": {
