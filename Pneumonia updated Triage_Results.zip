    {
      "cell_type": "code",
      "source": [
        "# Compare caps using the same scans for every setting within each run.\n",
        "settings = [\n",
        "    ('FIFO', None),\n",
        "    ('SCORE', None),\n",
        "    ('SCORE+CAP', 30),\n",
        "    ('SCORE+CAP', 60),\n",
        "    ('SCORE+CAP', 120)\n",
        "]\n",
        "\n",
        "cap_rows = []\n",
        "\n",
        "for seed in range(N_RUNS):\n",
        "    shift = make_scans(seed, share=PNEUMONIA_SHARE)\n",
        "\n",
        "    for rule, cap in settings:\n",
        "        name = rule if cap is None else f'CAP {cap}'\n",
        "\n",
        "        waits = run_queue(\n",
        "            shift,\n",
        "            rule,\n",
        "            cap=CAP_MIN if cap is None else cap\n",
        "        )\n",
        "\n",
        "        row = summarize(shift, waits)\n",
        "        row['setting'] = name\n",
        "        row['run'] = seed\n",
        "        cap_rows.append(row)\n",
        "\n",
        "cap_results = pd.DataFrame(cap_rows)\n",
        "order = ['FIFO', 'SCORE', 'CAP 30', 'CAP 60', 'CAP 120']\n",
        "\n",
        "metrics = {\n",
        "    'pneu_avg_wait': 'Pneumonia: average wait',\n",
        "    'missed_avg_wait': 'Missed: average wait',\n",
        "    'missed_max_wait': 'Missed: within-shift maximum',\n",
        "    'normal_avg_wait': 'Normal: average wait'\n",
        "}\n",
        "\n",
        "group = cap_results.groupby('setting')\n",
        "table = pd.DataFrame(index=order)\n",
        "\n",
        "# Each cell shows the mean and the 5th–95th-percentile spread.\n",
        "for column, title in metrics.items():\n",
        "    mean = group[column].mean().reindex(order)\n",
        "    low = group[column].quantile(0.05).reindex(order)\n",
        "    high = group[column].quantile(0.95).reindex(order)\n",
        "\n",
        "    table[title] = [\n",
        "        f'{m:.1f} [{lo:.1f}–{hi:.1f}]'\n",
        "        for m, lo, hi in zip(mean, low, high)\n",
        "    ]\n",
        "\n",
        "# Keep the single worst observed wait separate from the averages.\n",
        "table['Missed: worst across all runs'] = (\n",
        "    group['missed_max_wait'].max().reindex(order).round(1)\n",
        ")\n",
        "\n",
        "print(f'Cap comparison: {PNEUMONIA_SHARE:.0%} pneumonia share')\n",
        "print('Minutes: mean [5th–95th percentile across runs]')\n",
        "print('Missed-case statistics exclude shifts without missed cases.')\n",
        "display(table)\n",
        "\n",
        "fifo = cap_results[cap_results['setting'] == 'FIFO']\n",
        "n_with_missed = (fifo['missed_count'] > 0).sum()\n",
        "print(f'Shifts containing missed cases: {n_with_missed} of {N_RUNS}')\n",
        "\n",
        "table.to_csv('/content/cap_comparison.csv', index_label='Setting')\n",
        "print('Saved: cap_comparison.csv')"
      ],
