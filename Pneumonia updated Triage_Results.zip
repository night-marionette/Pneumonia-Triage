    },
    {
      "cell_type": "markdown",
      "source": [
        "# Main chart\n",
        "When the model misses a sick child, how long does that child wait? Each bar is the longest wait of a missed pneumonia scan, averaged over the shifts that had a missed scan. The black diamond is the worst single shift."
      ],
      "metadata": {
        "id": "XZCzg6Mhqswd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Two pools of scores from the CSV: one for pneumonia scans, one for normal scans\n",
        "pneu_pool = scores[scores['true_label'] == 1]['score'].values\n",
        "normal_pool = scores[scores['true_label'] == 0]['score'].values\n",
        "\n",
        "\n",
        "def make_scans(seed, share=PNEUMONIA_SHARE):\n",
        "    rng = np.random.default_rng(seed)   # the same seed gives the same shift\n",
        "\n",
        "    # 1. Arrival times: the backlog arrives at minute 0\n",
        "    arrivals = [0.0] * BACKLOG\n",
        "    t = 0.0\n",
        "    while True:\n",
        "        t = t + rng.exponential(ARRIVAL_MEAN_MIN)   # random gap until the next scan\n",
        "        if t > SHIFT_MIN:                           # the shift is over\n",
        "            break\n",
        "        arrivals.append(t)\n",
        "\n",
        "    n = len(arrivals)\n",
        "\n",
        "    # 2. True labels: each scan is pneumonia with probability = share\n",
        "    labels = (rng.random(n) < share).astype(int)\n",
        "\n",
        "    # 3. Scores: pneumonia scans take a score from the pneumonia pool, normal ones from the normal pool\n",
        "    scan_scores = np.where(labels == 1,\n",
        "                           rng.choice(pneu_pool, n),\n",
        "                           rng.choice(normal_pool, n))\n",
        "\n",
        "    # 4. Reading times: random, mean READ_MEAN_MIN\n",
        "    read_times = rng.exponential(READ_MEAN_MIN, n)\n",
        "\n",
        "    return pd.DataFrame({\n",
        "        'arrival': arrivals,\n",
        "        'true_label': labels,\n",
        "        'score': scan_scores,\n",
        "        'read_time': read_times\n",
        "    })\n",
        "\n",
        "\n",
        "def run_queue(shift, rule, cap=CAP_MIN):\n",
        "    arrival = shift['arrival'].values\n",
        "    label = shift['true_label'].values\n",
        "    score = shift['score'].values\n",
        "    read_time = shift['read_time'].values\n",
        "\n",
        "    n = len(shift)\n",
        "    done = np.zeros(n, dtype=bool)   # which scans have been read\n",
        "    waits = np.zeros(n)              # wait time of each scan\n",
        "    time = 0.0                       # the clock, in minutes\n",
        "\n",
        "    while not done.all():\n",
        "        # Scans that have arrived and are not read yet\n",
        "        waiting = np.where((arrival <= time) & (~done))[0]\n",
        "\n",
        "        # If nobody is waiting, jump the clock to the next arrival\n",
        "        if len(waiting) == 0:\n",
        "            time = arrival[~done].min()\n",
        "            continue\n",
        "\n",
        "        # The rule picks the next scan\n",
        "        if rule == 'FIFO':\n",
        "            chosen = waiting[np.argmin(arrival[waiting])]        # oldest first\n",
        "\n",
        "        elif rule == 'SCORE':\n",
        "            chosen = waiting[np.argmax(score[waiting])]          # highest score first\n",
        "\n",
        "        elif rule == 'SCORE+CAP':\n",
        "            over_cap = waiting[(time - arrival[waiting]) > cap]  # waited more than the cap\n",
        "            if len(over_cap) > 0:\n",
        "                chosen = over_cap[np.argmin(arrival[over_cap])]  # oldest of those first\n",
        "            else:\n",
        "                chosen = waiting[np.argmax(score[waiting])]      # otherwise highest score\n",
        "\n",
        "        elif rule == 'PERFECT':\n",
        "            pneumonia = waiting[label[waiting] == 1]\n",
        "            if len(pneumonia) > 0:\n",
        "                chosen = pneumonia[np.argmin(arrival[pneumonia])]   # true pneumonia first\n",
        "            else:\n",
        "                chosen = waiting[np.argmin(arrival[waiting])]\n",
        "\n",
        "        # The doctor reads the chosen scan\n",
        "        waits[chosen] = time - arrival[chosen]   # wait = start of reading minus arrival\n",
        "        time = time + read_time[chosen]\n",
        "        done[chosen] = True\n",
        "\n",
        "    return waits\n",
        "\n",
        "\n",
        "def summarize(shift, waits):\n",
        "    is_pneu = shift['true_label'].values == 1\n",
        "    is_missed = is_pneu & (shift['score'].values < THRESHOLD)\n",
        "    is_normal = ~is_pneu\n",
        "\n",
        "    result = {}\n",
        "    result['pneu_avg_wait'] = waits[is_pneu].mean() if is_pneu.any() else np.nan\n",
        "    result['pneu_p95_wait'] = np.percentile(waits[is_pneu], 95) if is_pneu.any() else np.nan\n",
        "    result['missed_count'] = is_missed.sum()\n",
        "    result['missed_avg_wait'] = waits[is_missed].mean() if is_missed.any() else np.nan\n",
        "    result['missed_max_wait'] = waits[is_missed].max() if is_missed.any() else np.nan\n",
        "    result['normal_avg_wait'] = waits[is_normal].mean() if is_normal.any() else np.nan\n",
        "    return result\n",
        "\n",
        "\n",
        "test_shift = make_scans(seed=1)\n",
        "print('Scans in this shift:', len(test_shift))\n",
        "print('Scans at minute 0 (backlog):', (test_shift['arrival'] == 0).sum())\n",
        "print('make_scans, run_queue and summarize are ready')"
      ],
      "metadata": {
        "id": "jkuxvsl3vS2z",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "a30fe762-94be-4d0d-8733-ee2e519edf37"
      },
      "execution_count": 47,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Scans in this shift: 118\n",
            "Scans at minute 0 (backlog): 30\n",
            "make_scans, run_queue and summarize are ready\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "RULES = ['FIFO', 'SCORE', 'SCORE+CAP', 'PERFECT']\n",
        "\n",
        "\n",
        "def run_experiment(share=PNEUMONIA_SHARE, cap=CAP_MIN, n_runs=N_RUNS):\n",
        "    rows = []\n",
        "    for seed in range(n_runs):\n",
        "        shift = make_scans(seed, share)          # ONE set of scans for this run\n",
        "        for rule in RULES:\n",
        "            waits = run_queue(shift, rule, cap)  # every rule uses the same scans\n",
        "            row = summarize(shift, waits)\n",
        "            row['rule'] = rule\n",
        "            row['run'] = seed\n",
        "            rows.append(row)\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "\n",
        "# Run with the base settings\n",
        "results = run_experiment()\n",
        "\n",
        "cols = ['pneu_avg_wait', 'pneu_p95_wait', 'missed_avg_wait',\n",
        "        'missed_max_wait', 'normal_avg_wait']\n",
        "\n",
        "average = results.groupby('rule')[cols].mean().loc[RULES].round(1)\n",
        "low = results.groupby('rule')[cols].quantile(0.05).loc[RULES].round(1)\n",
        "high = results.groupby('rule')[cols].quantile(0.95).loc[RULES].round(1)\n",
        "\n",
        "print('results is ready:', len(results), 'rows')\n",
        "print()\n",
        "print('AVERAGE across', N_RUNS, 'runs (minutes)')\n",
        "print(average)\n",
        "print()\n",
        "print('5th percentile across runs (low end of the spread)')\n",
        "print(low)\n",
        "print()\n",
        "print('95th percentile across runs (high end of the spread)')\n",
        "print(high)\n",
        "print()\n",
        "\n",
        "fifo_runs = results[results['rule'] == 'FIFO']\n",
        "print('Average number of missed pneumonia scans per shift:', round(fifo_runs['missed_count'].mean(), 2))\n",
        "print('Runs with at least one missed scan:', (fifo_runs['missed_count'] > 0).sum(), 'of', N_RUNS)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
